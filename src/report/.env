# Point at the DATA container (e.g. ztdata), NOT the $web hosting container.
# The $web container only hosts your index.html.
# The data container holds the JSON files uploaded by the runbook.
VITE_BLOB_BASE_URL="https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net/YOUR_DATA_CONTAINER"
VITE_BLOB_SAS_TOKEN="?YOUR_SAS_TOKEN_HERE"

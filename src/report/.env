# Since your BlobContainerName is "$web", the runbook uploads data to the SAME
# container that hosts the frontend. Use the STATIC WEBSITE endpoint — this is
# same-origin (no CORS needed) and publicly readable (no SAS token needed).
#
# Find your static website URL in:
#   Azure Portal > Storage Account > Static website > Primary endpoint
#
# Example: https://securityposturestorage1.z13.web.core.windows.net
VITE_BLOB_BASE_URL="https://securityposturestorage1.z13.web.core.windows.net"
VITE_BLOB_SAS_TOKEN=""
